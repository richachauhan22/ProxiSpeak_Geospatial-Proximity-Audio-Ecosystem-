# ==============================================================================
# PROXISPEAK CLIENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Base URL for Express / Node.js REST API
VITE_API_BASE_URL=http://localhost:4000

# Base URL for real-time Socket.io signaling & presence server
VITE_SOCKET_URL=http://localhost:4000

# Optional WebRTC STUN/TURN ICE Servers (comma-separated URLs)
# VITE_ICE_SERVERS=stun:stun.l.google.com:19302

# Default Spatial Proximity Threshold in Pixels (default: 100)
VITE_DEFAULT_PROXIMITY_RADIUS=100
