# ==============================================================================
# PROXISPEAK ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection String (Layout blueprints, furniture obstacles, & telemetry)
MONGO_URI=mongodb://localhost:27017/proxispeak

# Optional Redis Connection (Pub/Sub signaling relay across server instances)
# REDIS_URL=redis://localhost:6379

# Client Configuration
VITE_API_BASE_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
